def help_command(clientid, accountid, arguments):
    if arguments:
        command = arguments[0].lower().lstrip("/")

        if command == "spaz":
            send_spaz_help(clientid)
            return

        usage = COMMAND_USAGE.get(command)

        if usage:
            canonical = COMMAND_ALIASES.get(command, command)
            description = COMMAND_DESCRIPTIONS.get(
                canonical,
                COMMAND_DESCRIPTIONS.get(
                    command,
                    "Command description is not available."
                )
            )

            send(f"Command: /{command}", clientid)
            send(f"Usage: {usage}", clientid)

            if canonical != command:
                send(f"Alias for: /{canonical}", clientid)

            send(f"Description: {description}", clientid)

            example = COMMAND_EXAMPLES.get(canonical)
            if example:
                if command != canonical:
                    example = "/" + command + example[len("/" + canonical):]
                send(f"Example: {example}", clientid)

            return

        send(f"/{command} isn't a recognized command.", clientid)
        send("Use /help to see the available command groups.", clientid)
        return

    send("Player Commands", clientid)
    send("/help /ping /list /id /stats /me", clientid)
    send("/uniqeid /pb-id /accountid", clientid)
    send("Fun: /fly /inv /headless /creepy /celebrate /speed /spaz /floater", clientid)
    send("Cheats: /kill /heal /curse /sleep /superpunch /gloves /shield /freeze /godmode", clientid)
    send("Management: /recents /info /kick /ban /remove /sm /nv /dv /tint /pause /cameramode", clientid)
    send("Roles: /acl /vcl /createrole /addrole /removerole /getroles /addcommand /removecommand", clientid)
    send("Use /help <command> for full details.", clientid)
