logs = []


def push_log(msg):
    global logs
    logs.append(msg)


def init():
    global _discord_bot_thread
    global _discord_bot_started

    if _discord_bot_started:
        return

    if not token:
        raise RuntimeError("Discord token is empty.")

    _discord_bot_started = True

    def run_bot():
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)

        try:
            loop.run_until_complete(client.start(token))
        except BaseException:
            logging.exception("Discord bot stopped.")
        finally:
            try:
                if not client.is_closed():
                    loop.run_until_complete(client.close())
            except BaseException:
                pass

            try:
                loop.close()
            except BaseException:
                pass

    _discord_bot_thread = Thread(
        target=run_bot,
        name="DiscordBot",
        daemon=True,
    )
    _discord_bot_thread.start()



channel = None


@client.event
async def on_message(message):
    global channel

    if message.author.bot:
        return

    channel = message.channel

    if message.channel.id == logsChannelID:
        _babase.pushcall(
            Call(bs.chatmessage, message.content),
            from_other_thread=True,
        )

    # Keep prefix commands functional for the next phase.
    await client.process_commands(message)



@client.event
async def on_ready():
    template = discord_messages.get(
        "login",
        "Discord bot logged in as: {name}, {id}",
    )

    print(
        template.format(
            name=client.user.name,
            id=client.user.id,
        )
    )

    client.command_prefix = bot_prefix

    await verify_channel()







def _ui(path, default=None):
    value = ui_config

    for key in path.split("."):
        if not isinstance(value, dict):
            return default

        value = value.get(key)

    if value is None:
        return default

    return value


def _ui_color(path, default=0x5865F2):
    try:
        return int(_ui(path, default))
    except (TypeError, ValueError):
        return default


def _safe_text(value):
    return str(value).replace("`", "'")


def _split_game(value):
    value = str(value or "").strip()

    if not value:
        return (
            _ui(
                "dashboard.waiting",
                "Waiting for game...",
            ),
            "",
        )

    if " @ " in value:
        mode, game_map = value.split(" @ ", 1)
        return mode.strip(), game_map.strip()

    return value, ""


def _join_address():
    host = str(
        server_connect.get("host", "")
    ).strip()

    port = str(
        server_connect.get("port", "")
    ).strip()

    if host and port:
        return _ui(
            "dashboard.connection_format",
            "{host}:{port}",
        ).format(
            host=host,
            port=port,
        )

    return host or port


def _roster():
    result = []

    try:
        for account_id, player_data in (
            stats.get("roster", {}).items()
        ):
            result.append(
                {
                    "account_id": str(account_id),
                    "name": str(
                        player_data.get(
                            "name",
                            "<unknown>",
                        )
                    ),
                    "client_id": player_data.get(
                        "client_id"
                    ),
                    "device_id": player_data.get(
                        "device_id"
                    ),
                }
            )
    except BaseException:
        pass

    return result


def _recent_messages(limit=10):
    if not liveChat:
        return []

    try:
        messages = stats.get("chats", [])
        return [
            str(message)
            for message in messages[-limit:]
        ]
    except BaseException:
        return []


def _player_codeblock():
    players = _roster()

    if not players:
        return _ui(
            "dashboard.no_players",
            "```text\nNo active players\n```",
        )

    lines = []

    for index, player in enumerate(players, start=1):
        lines.append(
            _ui(
                "player_line",
                "{index}. {name}",
            ).format(
                index=index,
                name=_safe_text(
                    player["name"]
                ),
            )
        )

    language = _ui(
        "join_block_language",
        "text",
    )

    return (
        f"```{language}\n"
        + "\n".join(lines)
        + "\n```"
    )


def build_live_dashboard_embed():
    brand = _ui(
        "brand",
        "CYPHER DUELS",
    )

    title = _ui(
        "dashboard.title",
        "⚔️ {brand}",
    ).format(
        brand=brand,
    )

    subtitle = _ui(
        "dashboard.subtitle",
        "LIVE SERVER STATUS",
    )

    players = _roster()
    player_count = len(players)

    current_raw = ""
    next_raw = ""

    try:
        current_raw = str(
            stats.get(
                "playlist",
                {},
            ).get(
                "current",
                "",
            )
        )

        next_raw = str(
            stats.get(
                "playlist",
                {},
            ).get(
                "next",
                "",
            )
        )
    except BaseException:
        pass

    current_mode, current_map = _split_game(
        current_raw
    )

    next_mode, next_map = _split_game(
        next_raw
    )

    if not next_mode:
        next_mode = _ui(
            "dashboard.next_unavailable",
            "Not available",
        )

    if not next_map:
        next_map = ""

    embed = discord.Embed(
        title=title,
        description=f"**{subtitle}**",
        colour=discord.Colour(
            _ui_color(
                "colors.accent"
            )
        ),
    )

    # Server is online because this dashboard is being generated
    # by the connected bot/server instance; zero players != offline.
    embed.add_field(
        name=_ui(
            "dashboard.online",
            "🟢 ONLINE",
        ),
        value="",
        inline=True,
    )

    embed.add_field(
        name=_ui(
            "dashboard.players_field",
            "👥 Players ({count}/{max})",
        ).format(
            count=player_count,
            max=max_players,
        ),
        value="",
        inline=True,
    )

    embed.add_field(
        name=" ",
        value=" ",
        inline=True,
    )

    embed.add_field(
        name=_ui(
            "dashboard.current_game_field",
            "🎮 Current Game",
        ),
        value=(
            f"**{_ui('dashboard.mode_label', 'Mode')}:** "
            f"`{_safe_text(current_mode)}`\n"
            f"**{_ui('dashboard.map_label', 'Map')}:** "
            f"`{_safe_text(current_map or current_mode)}`"
        )[:1024],
        inline=True,
    )

    embed.add_field(
        name=_ui(
            "dashboard.next_game_field",
            "⏭️ Next Game",
        ),
        value=(
            f"**{_ui('dashboard.mode_label', 'Mode')}:** "
            f"`{_safe_text(next_mode)}`\n"
            f"**{_ui('dashboard.map_label', 'Map')}:** "
            f"`{_safe_text(next_map or '—')}`"
        )[:1024],
        inline=True,
    )

    embed.add_field(
        name=_ui(
            "dashboard.connection_field",
            "🔗 Server Address",
        ),
        value=(
            "```"
            + _join_address()
            + "```"
            + "\n"
            + _ui(
                "dashboard.connection_hint",
                "Long-press to copy.",
            )
        )[:1024],
        inline=False,
    )

    embed.add_field(
        name=_ui(
            "dashboard.players_field",
            "👥 Players",
        ),
        value=_player_codeblock(),
        inline=False,
    )

    embed.set_footer(
        text=_ui(
            "dashboard.footer",
            "CYPHER DUELS • Auto-refresh {interval}s",
        ).format(
            interval=int(
                refresh_interval
            )
        )
    )

    return embed


def build_live_messages_embed():
    embed = discord.Embed(
        title=_ui(
            "live_messages.title",
            "💬 Live Messages",
        ),
        colour=discord.Colour(
            _ui_color(
                "colors.messages"
            )
        ),
    )

    messages = _recent_messages(
        limit=10
    )

    if not liveChat:
        body = _ui(
            "live_messages.disabled",
            "```text\nLive chat is disabled\n```",
        )

    elif not messages:
        body = _ui(
            "live_messages.empty",
            "```text\nNo recent messages\n```",
        )

    else:
        body = (
            "```"
            + _ui(
                "recent_block_language",
                "text",
            )
            + "\n"
            + "\n".join(
                _safe_text(message)
                for message in messages
            )
            + "\n```"
        )

    embed.description = body[:4096]

    embed.set_footer(
        text=_ui(
            "live_messages.footer",
            "Recent in-game messages",
        )
    )

    return embed


def _is_staff(interaction):
    try:
        user_id = int(
            interaction.user.id
        )
    except BaseException:
        return False

    if user_id in allowed_user_ids:
        return True

    guild = interaction.guild

    if guild is not None:
        try:
            if user_id == int(guild.owner_id):
                return True
        except BaseException:
            pass

    return False


def _restart_server_on_ballistica_thread():
    try:
        _babase.restart_scheduled = True
    except BaseException:
        pass

    try:
        bs.chatmessage(
            "Server restart requested from Discord."
        )
    except BaseException:
        pass

    try:
        _babase.quit()
    except BaseException:
        logging.exception(
            "Unable to request server restart."
        )


def _send_in_game_message_on_ballistica_thread(
    message,
):
    _babase.pushcall(
        Call(
            bs.chatmessage,
            message,
        ),
        from_other_thread=True,
    )


class DashboardButton(discord.ui.Button):
    def __init__(
        self,
        *,
        label,
        style,
        custom_id,
        action,
        emoji=None,
    ):
        super().__init__(
            label=label,
            style=style,
            custom_id=custom_id,
            emoji=emoji,
        )

        self.action = action

    async def callback(self, interaction):
        await handle_button_action(
            interaction,
            self.action,
        )


