class BroadcastModal(discord.ui.Modal):
    def __init__(self):
        super().__init__(
            title=_ui(
                "modals.broadcast_title",
                "Send In-Game Message",
            )
        )

        self.message_input = discord.ui.TextInput(
            label=_ui(
                "modals.broadcast_label",
                "Message",
            ),
            placeholder=_ui(
                "modals.broadcast_placeholder",
                "Type your message...",
            ),
            style=discord.TextStyle.paragraph,
            required=True,
            max_length=500,
        )

        self.add_item(
            self.message_input
        )

    async def on_submit(self, interaction):
        message = str(
            self.message_input.value
        ).strip()

        if not message:
            await interaction.response.send_message(
                _ui(
                    "dialogs.message_empty",
                    "⚠️ The message cannot be empty.",
                ),
                ephemeral=True,
            )
            return

        if not _is_staff(interaction):
            await interaction.response.send_message(
                _ui(
                    "dialogs.not_authorized",
                    "⛔ You are not authorized.",
                ),
                ephemeral=True,
            )
            return

        _send_in_game_message_on_ballistica_thread(
            message
        )

        push_log(
            f"Discord broadcast by "
            f"{interaction.user}: {message}"
        )

        await interaction.response.send_message(
            _ui(
                "dialogs.message_sent",
                "✅ Message sent to the server.",
            ),
            ephemeral=True,
        )


async def handle_button_action(
    interaction,
    action,
):
    if action in {
        "status_refresh",
        "messages_refresh",
    }:
        try:
            await interaction.response.defer(
                ephemeral=True
            )

            await update_live_panels(
                force=True
            )

            await interaction.followup.send(
                _ui(
                    "dialogs.refreshed",
                    "✅ Refreshed.",
                ),
                ephemeral=True,
            )
        except BaseException:
            await interaction.followup.send(
                _ui(
                    "dialogs.status_error",
                    "⚠️ Unable to update.",
                ),
                ephemeral=True,
            )

        return

    if action == "status_restart":
        if not _is_staff(interaction):
            await interaction.response.send_message(
                _ui(
                    "dialogs.not_authorized",
                    "⛔ You are not authorized.",
                ),
                ephemeral=True,
            )
            return

        await interaction.response.send_message(
            (
                _ui(
                    "dialogs.restart_title",
                    "⚠️ Restart?",
                )
                + "\n\n"
                + _ui(
                    "dialogs.restart_body",
                    "This will restart the server.",
                )
            ),
            view=RestartConfirmView(),
            ephemeral=True,
        )

        return

    if action == "confirm_restart":
        if not _is_staff(interaction):
            await interaction.response.send_message(
                _ui(
                    "dialogs.not_authorized",
                    "⛔ You are not authorized.",
                ),
                ephemeral=True,
            )
            return

        await interaction.response.send_message(
            _ui(
                "dialogs.restart_requested",
                "🔄 Server restart requested.",
            ),
            ephemeral=True,
        )

        push_log(
            f"Server restart requested by "
            f"{interaction.user}"
        )

        _babase.pushcall(
            Call(
                _restart_server_on_ballistica_thread
            ),
            from_other_thread=True,
        )

        return

    if action == "cancel_restart":
        await interaction.response.send_message(
            _ui(
                "dialogs.cancelled",
                "Cancelled.",
            ),
            ephemeral=True,
        )
        return

    if action == "messages_recent":
        messages = _recent_messages(
            limit=10
        )

        if not messages:
            body = _ui(
                "live_messages.empty",
                "```text\nNo recent messages\n```",
            )
        else:
            body = (
                "```"
                + _ui(
                    "recent_block_language",
                    "text",
                )
                + "\n"
                + "\n".join(
                    _safe_text(message)
                    for message in messages
                )
                + "\n```"
            )

        await interaction.response.send_message(
            _ui(
                "dialogs.recent_title",
                "📜 Recent In-Game Messages",
            )
            + "\n\n"
            + body[:1850],
            ephemeral=True,
        )
        return

    if action == "messages_insert":
        if not _is_staff(interaction):
            await interaction.response.send_message(
                _ui(
                    "dialogs.not_authorized",
                    "⛔ You are not authorized.",
                ),
                ephemeral=True,
            )
            return

        await interaction.response.send_modal(
            BroadcastModal()
        )
        return


async def verify_channel():
    global livestatsmsgs
    global live_stats_message_id
    global live_chat_message_id
    global _refresh_task
    global _logs_task
    global _last_dashboard_signature
    global _last_messages_signature
    global _persistent_views_registered

    channel = client.get_channel(
        liveStatsChannelID
    )

    if channel is None:
        try:
            channel = await client.fetch_channel(
                liveStatsChannelID
            )
        except BaseException:
            logging.exception(
                "Unable to access live-stats channel."
            )
            return

    state = {}

    try:
        state_path = os.path.expanduser(
            state_file
        )

        if os.path.isfile(state_path):
            with open(
                state_path,
                "r",
                encoding="utf-8",
            ) as state_handle:
                state = json.load(
                    state_handle
                )

    except (
        OSError,
        ValueError,
    ):
        state = {}

    stats_id = state.get(
        "live_stats_message_id"
    )

    messages_id = state.get(
        "live_chat_message_id"
    )

    stats_message = None
    messages_message = None

    # Reuse ONLY our persisted API9 messages.
    if stats_id:
        try:
            stats_message = await channel.fetch_message(
                int(stats_id)
            )

            if stats_message.author.id != client.user.id:
                stats_message = None

        except (
            discord.NotFound,
            discord.HTTPException,
            ValueError,
        ):
            stats_message = None

    if messages_id:
        try:
            messages_message = await channel.fetch_message(
                int(messages_id)
            )

            if messages_message.author.id != client.user.id:
                messages_message = None

        except (
            discord.NotFound,
            discord.HTTPException,
            ValueError,
        ):
            messages_message = None

    # We deliberately never scan channel history here.
    # The same bot identity was previously used by API7.
    if stats_message is None:
        stats_message = await channel.send(
            embed=build_live_dashboard_embed(),
            view=LiveStatusView(),
        )

    if messages_message is None:
        messages_message = await channel.send(
            embed=build_live_messages_embed(),
            view=LiveMessagesView(),
        )

    live_stats_message_id = int(
        stats_message.id
    )

    live_chat_message_id = int(
        messages_message.id
    )

    livestatsmsgs = [
        stats_message,
        messages_message,
    ]

    try:
        state_path = os.path.expanduser(
            state_file
        )

        os.makedirs(
            os.path.dirname(
                state_path
            ),
            exist_ok=True,
        )

        with open(
            state_path,
            "w",
            encoding="utf-8",
        ) as state_handle:
            json.dump(
                {
                    "live_stats_message_id":
                        live_stats_message_id,
                    "live_chat_message_id":
                        live_chat_message_id,
                },
                state_handle,
                indent=2,
            )
            state_handle.write("\n")

        try:
            os.chmod(
                state_path,
                0o600,
            )
        except OSError:
            pass

    except OSError:
        logging.exception(
            "Unable to persist Discord live-message state."
        )

    # Register persistent views exactly once per bot process.
    if not _persistent_views_registered:
        try:
            client.add_view(
                LiveStatusView(),
                message_id=live_stats_message_id,
            )

            client.add_view(
                LiveMessagesView(),
                message_id=live_chat_message_id,
            )

            _persistent_views_registered = True

        except BaseException:
            logging.exception(
                "Unable to register persistent Discord views."
            )

    _last_dashboard_signature = None
    _last_messages_signature = None

    await update_live_panels(
        force=True
    )

    if _refresh_task is None or _refresh_task.done():
        _refresh_task = asyncio.create_task(
            refresh_stats()
        )

    if _logs_task is None or _logs_task.done():
        _logs_task = asyncio.create_task(
            send_logs()
        )




    # client.loop.create_task(refresh_stats())
    # client.loop.create_task(send_logs())


async def update_live_panels(force=False):
    global _last_dashboard_signature
    global _last_messages_signature

    if len(livestatsmsgs) < 2:
        return

    dashboard_embed = (
        build_live_dashboard_embed()
    )

    messages_embed = (
        build_live_messages_embed()
    )

    dashboard_signature = json.dumps(
        dashboard_embed.to_dict(),
        sort_keys=True,
        ensure_ascii=False,
    )

    messages_signature = json.dumps(
        messages_embed.to_dict(),
        sort_keys=True,
        ensure_ascii=False,
    )

    if (
        force
        or dashboard_signature
        != _last_dashboard_signature
    ):
        await livestatsmsgs[0].edit(
            content=None,
            embed=dashboard_embed,
            view=LiveStatusView(),
        )

        _last_dashboard_signature = (
            dashboard_signature
        )

    if (
        force
        or messages_signature
        != _last_messages_signature
    ):
        await livestatsmsgs[1].edit(
            content=None,
            embed=messages_embed,
            view=LiveMessagesView(),
        )

        _last_messages_signature = (
            messages_signature
        )

async def refresh_stats():
    await client.wait_until_ready()

    while not client.is_closed():
        if len(livestatsmsgs) >= 2:
            try:
                await update_live_panels(
                    force=False
                )
            except BaseException:
                logging.exception(
                    "Unable to update Discord panels."
                )

        await asyncio.sleep(
            max(
                float(
                    refresh_interval
                ),
                1.0,
            )
        )






def _log_clean(value):
    text = str(value)

    text = re.sub(
        r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]",
        "",
        text,
    )

    return text.strip()


def _log_icon(name, fallback):
    return (
        log_config
        .get("icons", {})
        .get(name, fallback)
    )


def _log_label(name, fallback):
    return (
        log_config
        .get("labels", {})
        .get(name, fallback)
    )


def _log_color(name, fallback):
    try:
        return int(
            log_config
            .get("colors", {})
            .get(name, fallback)
        )
    except (TypeError, ValueError):
        return fallback


def _log_player_name(account_id):
    account_id = str(account_id).strip()

    try:
        for roster_id, player in (
            stats.get("roster", {}).items()
        ):
            if str(roster_id) == account_id:
                return str(
                    player.get(
                        "name",
                        account_id,
                    )
                )
    except BaseException:
        pass

    return account_id


def _log_display_name(value):
    name = _log_clean(value)

    if not name:
        return "<unknown>"

    # Some old logs contain duplicated display names.
    parts = name.split()

    if len(parts) >= 2 and len(parts) % 2 == 0:
        half = len(parts) // 2

        if parts[:half] == parts[half:]:
            return " ".join(parts[:half])

    return name


def _log_time():
    if not log_config.get(
        "includeTimestamp",
        True,
    ):
        return ""

    return f" • <t:{int(time.time())}:t>"


def _format_join(raw):
    payload = raw.split(
        ":",
        1,
    )[1].strip()

    pieces = [
        _log_clean(part)
        for part in payload.split("|")
    ]

    pieces = [
        part
        for part in pieces
        if part
    ]

    player_name = (
        _log_display_name(pieces[0])
        if pieces
        else "<unknown>"
    )

    account_id = ""

    for piece in pieces[1:]:
        if (
            piece.startswith("pb-")
            or piece.startswith("a-")
        ):
            account_id = piece
            break

    description = (
        f"{_log_icon('join', '🟢')} "
        f"**{_log_label('playerJoined', 'PLAYER JOIN')}**\n"
        f"`{player_name}` joined the server"
        f"{_log_time()}"
    )

    if log_config.get(
        "showPlayerIdentifiers",
        False,
    ) and account_id:
        description += (
            "\n"
            f"```text\nPBID: {account_id}\n```"
        )

    return (
        description,
        _log_color("join", 0x57F287),
    )


def _format_leave(raw):
    payload = raw.split(
        ":",
        1,
    )[1].strip()

    pieces = [
        _log_clean(part)
        for part in payload.split("|")
    ]

    pieces = [
        piece
        for piece in pieces
        if piece
    ]

    player_name = (
        _log_display_name(pieces[0])
        if pieces
        else "<unknown>"
    )

    return (
        (
            f"{_log_icon('leave', '🔴')} "
            f"**{_log_label('playerLeft', 'PLAYER LEFT')}**\n"
            f"`{player_name}` left the server"
            f"{_log_time()}"
        ),
        _log_color("leave", 0xED4245),
    )


def _format_chat(raw):
    payload = raw.split(
        ":",
        1,
    )[1].strip()

    pieces = [
        _log_clean(part)
        for part in payload.split("|")
    ]

    pieces = [
        piece
        for piece in pieces
        if piece
    ]

    if not pieces:
        return None

    message = pieces[-1]

    if not message:
        return None

    sender = "Player"

    account_id = pieces[0]

    if (
        account_id.startswith("pb-")
        or account_id.startswith("a-")
    ):
        sender = _log_player_name(
            account_id
        )

    elif len(pieces) >= 2:
        sender = pieces[-2]

    sender = _log_display_name(sender)

    return (
        (
            f"{_log_icon('chat', '💬')} "
            f"**{_log_label('chat', 'CHAT')}**\n"
            f"`{sender}`: {_log_clean(message)}"
            f"{_log_time()}"
        ),
        _log_color("chat", 0x5865F2),
    )


def _format_bridge(raw):
    payload = _log_clean(raw)

    marker = "Discord broadcast by"

    if marker in payload:
        payload = payload.split(
            marker,
            1,
        )[1].strip()

    sender = ""
    message = payload

    if ":" in payload:
        sender, message = payload.split(
            ":",
            1,
        )

    sender = _log_clean(sender)
    message = _log_clean(message)

    if sender:
        rendered = (
            f"`{sender}` → {message}"
        )
    else:
        rendered = message

    return (
        (
            f"{_log_icon('discord', '📣')} "
            f"**{_log_label('discordBridge', 'DISCORD → GAME')}**\n"
            f"{rendered}"
            f"{_log_time()}"
        ),
        _log_color("discord", 0x8B5CF6),
    )


def _format_moderation(raw):
    clean = _log_clean(raw)

    return (
        (
            f"{_log_icon('moderation', '🛡️')} "
            f"**{_log_label('moderation', 'PLAYER MODERATION')}**\n"
            f"{clean}"
            f"{_log_time()}"
        ),
        _log_color("moderation", 0xFEE75C),
    )


def _format_server(raw):
    clean = _log_clean(raw)

    return (
        (
            f"{_log_icon('server', '🚀')} "
            f"**{_log_label('serverStarted', 'SERVER EVENT')}**\n"
            f"{clean}"
            f"{_log_time()}"
        ),
        _log_color("server", 0x57F287),
    )


def _format_unknown(raw):
    clean = _log_clean(raw)

    if not clean:
        return None

    return (
        (
            f"{_log_icon('event', '📝')} "
            f"**{_log_label('event', 'EVENT')}**\n"
            f"{clean}"
            f"{_log_time()}"
        ),
        _log_color("event", 0x99AAB5),
    )


def _format_server_log(raw):
    raw = _log_clean(raw)

    if not raw:
        return None

    lowered = raw.lower()

    if raw.startswith("playerjoin:"):
        if not log_config.get(
            "showPlayerJoin",
            True,
        ):
            return None

        return _format_join(raw)

    if raw.startswith("chat:"):
        if not log_config.get(
            "showChat",
            True,
        ):
            return None

        return _format_chat(raw)

    if lowered.startswith(
        "discord broadcast by"
    ):
        if not log_config.get(
            "showDiscordBridge",
            True,
        ):
            return None

        return _format_bridge(raw)

    if (
        "left server" in lowered
        or "disconnected" in lowered
    ):
        if not log_config.get(
            "showPlayerLeave",
            True,
        ):
            return None

        clean = raw

        if "|" in clean:
            clean = clean.split(
                "|",
                1,
            )[0].strip()

        if ":" in clean:
            clean = clean.split(
                ":",
                1,
            )[-1].strip()

        return (
            (
                f"{_log_icon('leave', '🔴')} "
                f"**{_log_label('playerLeft', 'PLAYER LEFT')}**\n"
                f"{clean}"
                f"{_log_time()}"
            ),
            _log_color("leave", 0xED4245),
        )

    if any(
        term in lowered
        for term in (
            "kicked",
            " kick ",
            "kick ",
            "banned",
            " ban ",
            "muted",
            "unmuted",
            "kick vote",
        )
    ):
        if not log_config.get(
            "showModeration",
            True,
        ):
            return None

        return _format_moderation(raw)

    if (
        lowered == "sys:server started"
        or lowered == "server started"
    ):
        if not log_config.get(
            "showServerEvents",
            True,
        ):
            return None

        return _format_server(
            "Server started"
        )

    # Hide internal sys records unless explicitly enabled.
    if lowered.startswith("sys:"):
        if not (
            log_config.get(
                "showPlayerIdentifiers",
                False,
            )
            or log_config.get(
                "showDeviceIdentifiers",
                False,
            )
            or log_config.get(
                "showIPAddresses",
                False,
            )
        ):
            return None

    if lowered.startswith("host msg:"):
        if not log_config.get(
            "showChat",
            True,
        ):
            return None

        message = _log_clean(
            raw.split(
                ":",
                1,
            )[1]
        )

        return (
            (
                f"{_log_icon('chat', '💬')} "
                f"**{_log_label('chat', 'CHAT')}**\n"
                f"`HOST`: {message}"
                f"{_log_time()}"
            ),
            _log_color("chat", 0x5865F2),
        )

    if not log_config.get(
        "showUnknownEvents",
        True,
    ):
        return None

    return _format_unknown(raw)

def _compact_clean(value):
    text = str(value)

    text = re.sub(
        r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]",
        "",
        text,
    )

    return text.strip()


def _compact_code(value):
    value = _compact_clean(value)

    # Keep Discord inline-code safe.
    value = value.replace("`", "'")

    return f"`{value}`"


def _compact_message(value):
    value = _compact_clean(value)

    # Prevent log messages from accidentally pinging staff/roles.
    value = value.replace("@", "@\u200b")

    return value


def _compact_icon(name, fallback):
    return (
        log_config
        .get("icons", {})
        .get(name, fallback)
    )


def _compact_label(name, fallback):
    return (
        log_config
        .get("labels", {})
        .get(name, fallback)
    )


def _compact_color(name, fallback):
    try:
        return int(
            log_config
            .get("colors", {})
            .get(name, fallback)
        )
    except (TypeError, ValueError):
        return fallback


def _compact_time():
    if not log_config.get(
        "includeTimestamp",
        True,
    ):
        return ""

    return f" • <t:{int(time.time())}:t>"


def _extract_pbid(text):
    match = re.search(
        r"\b(pb-[A-Za-z0-9+/=_-]+|a-\d+)\b",
        text,
    )

    return match.group(1) if match else ""


def _extract_ip(text):
    match = re.search(
        r"\bIP\s*:\s*([^\s|,]+)",
        text,
        flags=re.IGNORECASE,
    )

    if match:
        return match.group(1)

    match = re.search(
        r"\bip\s*:\s*([^\s|,]+)",
        text,
        flags=re.IGNORECASE,
    )

    return match.group(1) if match else ""


def _extract_device(text):
    match = re.search(
        r"\bDevice\s*id\s*:\s*([^\s|,]+)",
        text,
        flags=re.IGNORECASE,
    )

    return match.group(1) if match else ""


def _find_player_name(pbid):
    if not pbid:
        return ""

    try:
        for account_id, player_data in (
            stats.get("roster", {}).items()
        ):
            if str(account_id) == str(pbid):
                return _compact_clean(
                    player_data.get(
                        "name",
                        "",
                    )
                )
    except BaseException:
        pass

    return ""


def _deduplicate_name(name):
    name = _compact_clean(name)

    if not name:
        return "<unknown>"

    parts = name.split()

    if len(parts) >= 2 and len(parts) % 2 == 0:
        half = len(parts) // 2

        if parts[:half] == parts[half:]:
            return " ".join(parts[:half])

    return name


def _format_compact_join(raw):
    payload = raw.split(
        ":",
        1,
    )[1].strip()

    pieces = [
        _compact_clean(part)
        for part in payload.split("|")
    ]

    pieces = [
        part
        for part in pieces
        if part
    ]

    pbid = _extract_pbid(payload)

    name = ""

    if pieces:
        name = _deduplicate_name(
            pieces[0]
        )

    if (
        not name
        or name.startswith("pb-")
        or name.startswith("a-")
    ):
        name = _find_player_name(
            pbid
        ) or name

    line = (
        f"{_compact_icon('join', '🟢')} "
        f"**{_compact_label('playerJoined', 'PLAYER JOIN')}** "
        f"{_compact_code(name)}"
    )

    if (
        pbid
        and log_config.get(
            "showPlayerIdentifiers",
            True,
        )
    ):
        line += (
            f" · {_compact_code('PBID: ' + pbid)}"
        )

    return (
        line
        + _compact_time(),
        _compact_color(
            "join",
            0x57F287,
        ),
    )


def _format_compact_leave(raw):
    payload = raw.split(
        ":",
        1
    )[1].strip()

    pieces = [
        _compact_clean(part)
        for part in payload.split("|")
    ]

    pieces = [
        part
        for part in pieces
        if part
    ]

    name = (
        _deduplicate_name(
            pieces[0]
        )
        if pieces
        else "<unknown>"
    )

    pbid = _extract_pbid(
        payload
    )

    if (
        not name
        or name.startswith("pb-")
        or name.startswith("a-")
    ):
        name = _find_player_name(
            pbid
        ) or name

    line = (
        f"{_compact_icon('leave', '🔴')} "
        f"**{_compact_label('playerLeft', 'PLAYER LEFT')}** "
        f"{_compact_code(name)}"
    )

    if (
        pbid
        and log_config.get(
            "showPlayerIdentifiers",
            True,
        )
    ):
        line += (
            f" · {_compact_code('PBID: ' + pbid)}"
        )

    return (
        line
        + _compact_time(),
        _compact_color(
            "leave",
            0xED4245,
        ),
    )


def _format_compact_chat(raw):
    payload = raw.split(
        ":",
        1,
    )[1].strip()

    pieces = [
        _compact_clean(part)
        for part in payload.split("|")
    ]

    pieces = [
        part
        for part in pieces
        if part
    ]

    if not pieces:
        return None

    message = pieces[-1]

    if not message:
        return None

    pbid = _extract_pbid(
        " ".join(pieces[:2])
    )

    name = ""

    if pbid:
        name = _find_player_name(
            pbid
        )

    # Legacy chat commonly contains:
    # PBID | display name | display name | message
    if not name and len(pieces) >= 3:
        name = _deduplicate_name(
            pieces[-2]
        )

    if not name and len(pieces) >= 2:
        name = _deduplicate_name(
            pieces[-2]
        )

    if not name:
        name = "Player"

    line = (
        f"{_compact_icon('chat', '💬')} "
        f"**{_compact_label('chat', 'CHAT')}** "
        f"{_compact_code(name)}: "
        f"{_compact_message(message)}"
    )

    return (
        line
        + _compact_time(),
        _compact_color(
            "chat",
            0x5865F2,
        ),
    )


def _format_compact_sys(raw):
    payload = raw.split(
        ":",
        1
    )[1].strip()

    pbid = _extract_pbid(
        payload
    )

    ip = _extract_ip(
        payload
    )

    device = _extract_device(
        payload
    )

    name = _find_player_name(
        pbid
    )

    lower = payload.lower()

    parts = []

    if name:
        parts.append(
            _compact_code(name)
        )

    # Only display V2 when it is actually present in the source event.
    if re.search(
        r"\bv2\b",
        payload,
        flags=re.IGNORECASE,
    ):
        parts.append(
            _compact_code("V2")
        )

    if (
        pbid
        and log_config.get(
            "showPlayerIdentifiers",
            True,
        )
    ):
        parts.append(
            _compact_code(
                "PBID: " + pbid
            )
        )

    if (
        ip
        and log_config.get(
            "showIPAddresses",
            True,
        )
    ):
        parts.append(
            _compact_code(
                "IP: " + ip
            )
        )

    if (
        device
        and log_config.get(
            "showDeviceIdentifiers",
            True,
        )
    ):
        parts.append(
            _compact_code(
                "Device: " + device
            )
        )

    # Preserve useful unidentified system details without reverting
    # to a giant raw line.
    if not parts:
        cleaned = _compact_clean(
            payload
        )

        if cleaned:
            parts.append(
                _compact_code(
                    cleaned[:220]
                )
            )

    if not parts:
        return None

    line = (
        f"{_compact_icon('info', '🧾')} "
        f"**{_compact_label('playerInfo', 'PLAYER INFO')}** "
        + " · ".join(parts)
    )

    return (
        line
        + _compact_time(),
        _compact_color(
            "info",
            0x99AAB5,
        ),
    )


def _format_compact_bridge(raw):
    payload = _compact_clean(
        raw
    )

    marker = "Discord broadcast by"

    if marker in payload:
        payload = payload.split(
            marker,
            1
        )[1].strip()

    sender = ""
    message = payload

    if ":" in payload:
        sender, message = payload.split(
            ":",
            1
        )

    sender = _compact_clean(
        sender
    )

    message = _compact_message(
        message
    )

    if sender:
        body = (
            f"{_compact_code(sender)}: "
            f"{message}"
        )
    else:
        body = message

    return (
        (
            f"{_compact_icon('discord', '📣')} "
            f"**{_compact_label('discordBridge', 'DISCORD → GAME')}** "
            f"{body}"
            f"{_compact_time()}"
        ),
        _compact_color(
            "discord",
            0x8B5CF6,
        ),
    )


def _format_compact_moderation(raw):
    clean = _compact_message(
        raw
    )

    return (
        (
            f"{_compact_icon('moderation', '🛡️')} "
            f"**{_compact_label('moderation', 'MODERATION')}** "
            f"{clean}"
            f"{_compact_time()}"
        ),
        _compact_color(
            "moderation",
            0xFEE75C,
        ),
    )


def _format_compact_server(raw):
    return (
        (
            f"{_compact_icon('server', '🚀')} "
            f"**{_compact_label('serverStarted', 'SERVER STARTED')}**"
            f"{_compact_time()}"
        ),
        _compact_color(
            "server",
            0x57F287,
        ),
    )


def _format_compact_unknown(raw):
    clean = _compact_message(
        raw
    )

    if not clean:
        return None

    return (
        (
            f"{_compact_icon('event', '📝')} "
            f"**{_compact_label('event', 'EVENT')}** "
            f"{clean}"
            f"{_compact_time()}"
        ),
        _compact_color(
            "event",
            0x99AAB5,
        ),
    )


def _normalize_log_event(raw):
    """
    Logger.py currently sends events in this format:

        ***chat:***message
        ***playerjoin:***player | pbid | joined server
        ***sys:***technical details

    Normalize that into:
        (event_type, payload)
    """

    text = _compact_clean(raw)

    wrapped = re.match(
        r"^\*{3}\s*([A-Za-z0-9_ -]+?)\s*:\*{3}(.*)$",
        text,
        flags=re.DOTALL,
    )

    if wrapped:
        event_type = (
            wrapped.group(1)
            .strip()
            .lower()
        )

        payload = (
            wrapped.group(2)
            .strip()
        )

        return event_type, payload

    # Compatibility with unwrapped events.
    match = re.match(
        r"^([A-Za-z0-9_ -]+):\s*(.*)$",
        text,
        flags=re.DOTALL,
    )

    if match:
        return (
            match.group(1).strip().lower(),
            match.group(2).strip(),
        )

    return "", text


def _extract_field(text, names):
    for name in names:
        match = re.search(
            rf"{re.escape(name)}\s*:\s*([^\s|,]+)",
            text,
            flags=re.IGNORECASE,
        )

        if match:
            return match.group(1).strip()

    return ""


def _extract_pbid_anywhere(text):
    match = re.search(
        r"\b(pb-[A-Za-z0-9+/=_-]+|a-\d+)\b",
        text,
    )

    return (
        match.group(1)
        if match
        else ""
    )


def _format_join_payload(payload):
    pieces = [
        _compact_clean(part)
        for part in payload.split("|")
    ]

    pieces = [
        part
        for part in pieces
        if part
    ]

    pbid = _extract_pbid_anywhere(
        payload
    )

    name = ""

    # logger format is generally:
    # player-name | pbid | joined server
    if pieces:
        candidate = pieces[0]

        if not (
            candidate.startswith("pb-")
            or candidate.startswith("a-")
        ):
            name = _deduplicate_name(
                candidate
            )

    if not name:
        name = _find_player_name(
            pbid
        )

    if not name:
        name = "<unknown>"

    line = (
        f"{_compact_icon('join', '🟢')} "
        f"**{_compact_label('playerJoined', 'PLAYER JOIN')}** "
        f"{_compact_code(name)}"
    )

    if (
        pbid
        and log_config.get(
            "showPlayerIdentifiers",
            True,
        )
    ):
        line += (
            f" · "
            f"{_compact_code('PBID: ' + pbid)}"
        )

    return (
        line + _compact_time(),
        _compact_color(
            "join",
            0x57F287,
        ),
    )


def _format_leave_payload(payload):
    pieces = [
        _compact_clean(part)
        for part in payload.split("|")
    ]

    pieces = [
        part
        for part in pieces
        if part
    ]

    pbid = _extract_pbid_anywhere(
        payload
    )

    name = ""

    if pieces:
        candidate = pieces[0]

        if not (
            candidate.startswith("pb-")
            or candidate.startswith("a-")
        ):
            name = _deduplicate_name(
                candidate
            )

    if not name:
        name = _find_player_name(
            pbid
        )

    if not name:
        name = "<unknown>"

    line = (
        f"{_compact_icon('leave', '🔴')} "
        f"**{_compact_label('playerLeft', 'PLAYER LEFT')}** "
        f"{_compact_code(name)}"
    )

    if (
        pbid
        and log_config.get(
            "showPlayerIdentifiers",
            True,
        )
    ):
        line += (
            f" · "
            f"{_compact_code('PBID: ' + pbid)}"
        )

    return (
        line + _compact_time(),
        _compact_color(
            "leave",
            0xED4245,
        ),
    )


def _format_chat_payload(payload):
    pieces = [
        _compact_clean(part)
        for part in payload.split("|")
    ]

    pieces = [
        piece
        for piece in pieces
        if piece
    ]

    if not pieces:
        return None

    message = pieces[-1]

    if not message:
        return None

    pbid = _extract_pbid_anywhere(
        " ".join(pieces[:3])
    )

    name = (
        _find_player_name(
            pbid
        )
        if pbid
        else ""
    )

    # Typical legacy layout:
    # PBID | display-name | display-name | message
    if not name and len(pieces) >= 3:
        name = _deduplicate_name(
            pieces[-2]
        )

    if not name and len(pieces) >= 2:
        name = _deduplicate_name(
            pieces[-2]
        )

    if not name:
        name = "Player"

    line = (
        f"{_compact_icon('chat', '💬')} "
        f"**{_compact_label('chat', 'CHAT')}** "
        f"{_compact_code(name)}: "
        f"{_compact_message(message)}"
    )

    return (
        line + _compact_time(),
        _compact_color(
            "chat",
            0x5865F2,
        ),
    )


def _format_sys_payload(payload):
    """
    Render technical sys records compactly.

    Example visual result:

    🧾 PLAYER INFO `Cypher13` · `V2` ·
    `PBID: pb-...` · `IP: ...` · `Device: ...`
    """

    pbid = _extract_pbid_anywhere(
        payload
    )

    ip = _extract_field(
        payload,
        (
            "ip",
            "IP",
        ),
    )

    device = _extract_field(
        payload,
        (
            "device id",
            "device_id",
            "device",
        ),
    )

    name = _find_player_name(
        pbid
    )

    # V2 may appear in the raw account/type data.
    is_v2 = bool(
        re.search(
            r"\bv2\b",
            payload,
            flags=re.IGNORECASE,
        )
    )

    parts = []

    if name:
        parts.append(
            _compact_code(name)
        )

    if is_v2:
        parts.append(
            _compact_code("V2")
        )

    if (
        pbid
        and log_config.get(
            "showPlayerIdentifiers",
            True,
        )
    ):
        parts.append(
            _compact_code(
                "PBID: " + pbid
            )
        )

    if (
        ip
        and log_config.get(
            "showIPAddresses",
            True,
        )
    ):
        parts.append(
            _compact_code(
                "IP: " + ip
            )
        )

    if (
        device
        and log_config.get(
            "showDeviceIdentifiers",
            True,
        )
    ):
        parts.append(
            _compact_code(
                "Device: " + device
            )
        )

    # When the record doesn't contain the recognizable fields,
    # don't throw away the technical information; show it compactly.
    if not parts:
        clean = _compact_message(
            payload
        )

        if clean:
            parts.append(
                _compact_code(
                    clean[:250]
                )
            )

    if not parts:
        return None

    line = (
        f"{_compact_icon('info', '🧾')} "
        f"**{_compact_label('playerInfo', 'PLAYER INFO')}** "
        + " · ".join(parts)
    )

    return (
        line + _compact_time(),
        _compact_color(
            "info",
            0x99AAB5,
        ),
    )


def _compact_log(raw):
    raw = _compact_clean(
        raw
    )

    if not raw:
        return None

    event_type, payload = (
        _normalize_log_event(raw)
    )

    lowered = raw.lower()

    # --------------------------------------------------------
    # Structured logger event types.
    # --------------------------------------------------------

    if event_type == "playerjoin":
        if not log_config.get(
            "showPlayerJoin",
            True,
        ):
            return None

        return _format_join_payload(
            payload
        )

    if event_type in {
        "chat",
        "message",
    }:
        if not log_config.get(
            "showChat",
            True,
        ):
            return None

        return _format_chat_payload(
            payload
        )

    if event_type in {
        "sys",
        "system",
    }:
        return _format_sys_payload(
            payload
        )

    # --------------------------------------------------------
    # Discord bridge.
    # --------------------------------------------------------

    if (
        "discord broadcast by"
        in lowered
    ):
        if not log_config.get(
            "showDiscordBridge",
            True,
        ):
            return None

        return _format_compact_bridge(
            raw
        )

    # --------------------------------------------------------
    # Server lifecycle.
    # --------------------------------------------------------

    if (
        "server started"
        in lowered
    ):
        if not log_config.get(
            "showServerEvents",
            True,
        ):
            return None

        return _format_compact_server(
            "Server started"
        )

    # --------------------------------------------------------
    # Player leave / disconnect.
    # --------------------------------------------------------

    if (
        "left server"
        in lowered
        or "disconnected"
        in lowered
    ):
        if not log_config.get(
            "showPlayerLeave",
            True,
        ):
            return None

        pbid = _extract_pbid_anywhere(
            raw
        )

        name = _find_player_name(
            pbid
        )

        if not name:
            name = raw

            # Remove the technical suffix.
            if "|" in name:
                name = name.split(
                    "|",
                    1
                )[0]

            if ":" in name:
                prefix, remainder = (
                    name.split(
                        ":",
                        1
                    )
                )

                if prefix.lower() in {
                    "playerleft",
                    "leave",
                }:
                    name = remainder

            name = _deduplicate_name(
                name
            )

        line = (
            f"{_compact_icon('leave', '🔴')} "
            f"**{_compact_label('playerLeft', 'PLAYER LEFT')}** "
            f"{_compact_code(name)}"
        )

        if (
            pbid
            and log_config.get(
                "showPlayerIdentifiers",
                True,
            )
        ):
            line += (
                f" · "
                f"{_compact_code('PBID: ' + pbid)}"
            )

        return (
            line + _compact_time(),
            _compact_color(
                "leave",
                0xED4245,
            ),
        )

    # --------------------------------------------------------
    # Moderation.
    # --------------------------------------------------------

    if any(
        term in lowered
        for term in (
            "kicked",
            "kick ",
            "banned",
            " ban ",
            "muted",
            "unmuted",
            "kick vote",
        )
    ):
        if not log_config.get(
            "showModeration",
            True,
        ):
            return None

        return _format_compact_moderation(
            raw
        )

    # --------------------------------------------------------
    # Host message.
    # --------------------------------------------------------

    if (
        event_type == "host msg"
        or lowered.startswith(
            "host msg:"
        )
    ):
        if not log_config.get(
            "showChat",
            True,
        ):
            return None

        if ":" in raw:
            message = raw.split(
                ":",
                1,
            )[1]
        else:
            message = payload

        return (
            (
                f"{_compact_icon('chat', '💬')} "
                f"**{_compact_label('chat', 'CHAT')}** "
                f"{_compact_code('HOST')}: "
                f"{_compact_message(message)}"
                f"{_compact_time()}"
            ),
            _compact_color(
                "chat",
                0x5865F2,
            ),
        )

    # --------------------------------------------------------
    # Unknown event.
    # --------------------------------------------------------

    if not log_config.get(
        "showUnknownEvents",
        True,
    ):
        return None

    return _format_compact_unknown(
        raw
    )


async def send_logs():
    global logs

    await client.wait_until_ready()

    channel = client.get_channel(
        logsChannelID
    )

    if channel is None:
        try:
            channel = await client.fetch_channel(
                logsChannelID
            )
        except BaseException:
            logging.exception(
                "Unable to access Discord logs channel."
            )
            return

    if not log_config.get(
        "enabled",
        True,
    ):
        return

    interval = max(
        float(
            logs_batch_interval
        ),
        1.0,
    )

    max_events = max(
        int(
            log_config.get(
                "maxEventsPerBatch",
                10,
            )
        ),
        1,
    )

    max_chars = min(
        max(
            int(
                log_config.get(
                    "maxMessageCharacters",
                    1800,
                )
            ),
            700,
        ),
        1900,
    )

    while not client.is_closed():

        if logs:
            pending = logs[
                :max_events
            ]

            del logs[
                :len(pending)
            ]

            formatted = []

            for raw in pending:
                try:
                    item = _compact_log(
                        raw
                    )
                except BaseException:
                    logging.exception(
                        "Discord log parser failed."
                    )
                    item = None

                if item:
                    formatted.append(
                        item
                    )

            if formatted:

                lines = [
                    item[0]
                    for item in formatted
                ]

                body = "\n".join(
                    lines
                )

                if len(body) > max_chars:
                    body = (
                        body[
                            :max_chars - 3
                        ]
                        + "..."
                    )

                color = formatted[0][1]

                embed = discord.Embed(
                    description=body,
                    colour=discord.Colour(
                        int(color)
                    ),
                )

                # Deliberately no repetitive title/footer.
                embed.set_footer(
                    text=""
                )

                try:
                    await channel.send(
                        embed=embed
                    )
                except BaseException:
                    logging.exception(
                        "Unable to send compact Discord logs."
                    )

        await asyncio.sleep(
            interval
        )






