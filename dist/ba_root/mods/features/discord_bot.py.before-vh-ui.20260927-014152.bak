logging.getLogger('asyncio').setLevel(logging.WARNING)
intents = discord.Intents().all()

client = Bot(command_prefix=lambda *_args: [], intents=intents)
# client = discord.Client()


stats = {}
livestatsmsgs = []

# Runtime configuration injected by custom_hooks.py from setting.json.
logsChannelID = 0
liveStatsChannelID = 0
notifyChannelID = 0
complaintChannelID = 0
guildID = 0

liveChat = True
bot_prefix = ""
token = ""

refresh_interval = 10.0
stats_refresh_interval = 8.0
channel_history_limit = 20
state_file = ""

discord_messages = {}

ui_config = {}
server_connect = {}
max_players = 5

_last_dashboard_embed = None
_last_chat_embed = None
_persistent_view_registered = False

# Persisted IDs for the API9 bot's own managed Discord messages.
live_stats_message_id = None
live_chat_message_id = None

# Last contents sent to Discord. Avoid unnecessary PATCH requests.
_last_live_stats_content = None
_last_live_chat_content = None

# Discord asyncio thread state.
_discord_bot_thread = None
_discord_bot_started = False
_refresh_task = None
_logs_task = None

logs = []


def push_log(msg):
    global logs
    logs.append(msg)


def init():
    global _discord_bot_thread
    global _discord_bot_started

    if _discord_bot_started:
        return

    if not token:
        raise RuntimeError("Discord token is empty.")

    _discord_bot_started = True

    def run_bot():
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)

        try:
            loop.run_until_complete(client.start(token))
        except BaseException:
            logging.exception("Discord bot stopped.")
        finally:
            try:
                if not client.is_closed():
                    loop.run_until_complete(client.close())
            except BaseException:
                pass

            try:
                loop.close()
            except BaseException:
                pass

    _discord_bot_thread = Thread(
        target=run_bot,
        name="DiscordBot",
        daemon=True,
    )
    _discord_bot_thread.start()



channel = None


@client.event
async def on_message(message):
    global channel

    if message.author.bot:
        return

    channel = message.channel

    if message.channel.id == logsChannelID:
        _babase.pushcall(
            Call(bs.chatmessage, message.content),
            from_other_thread=True,
        )

    # Keep prefix commands functional for the next phase.
    await client.process_commands(message)



@client.event
@client.event
async def on_ready():
    global _persistent_view_registered

    template = discord_messages.get(
        "login",
        "Discord bot logged in as: {name}, {id}",
    )

    print(
        template.format(
            name=client.user.name,
            id=client.user.id,
        )
    )

    client.command_prefix = bot_prefix

    await verify_channel()

    if not _persistent_view_registered:
        if live_stats_message_id:
            try:
                client.add_view(
                    LiveDashboardView(),
                    message_id=int(live_stats_message_id),
                )
                _persistent_view_registered = True
            except BaseException:
                logging.exception(
                    "Unable to register persistent dashboard controls."
                )





def _ui(path, default=None):
    value = ui_config

    for key in path.split("."):
        if not isinstance(value, dict):
            return default
        value = value.get(key)

    return default if value is None else value


def _ui_color(path, default=0x5865F2):
    try:
        return int(_ui(path, default))
    except (TypeError, ValueError):
        return default


def _safe_text(value):
    return str(value).replace("`", "'")


def _split_game_label(value):
    value = str(value or "").strip()

    if " @ " in value:
        mode, game_map = value.split(" @ ", 1)
        return mode.strip(), game_map.strip()

    return value, _ui("dashboard.no_current_map", "")


def _join_address():
    host = str(server_connect.get("host", "")).strip()
    port = str(server_connect.get("port", "")).strip()

    if host and port:
        return f"{host}:{port}"

    return host or port


def _roster_items():
    result = []

    try:
        roster = stats.get("roster", {})

        for account_id, player_data in roster.items():
            name = player_data.get("name", _ui("dashboard.empty_players", ""))
            result.append({
                "account_id": str(account_id),
                "name": str(name),
                "client_id": player_data.get("client_id"),
                "device_id": player_data.get("device_id"),
            })

    except BaseException:
        return []

    return result


def _recent_chats():
    if not liveChat:
        return []

    try:
        chats = stats.get("chats", [])
        return [str(item) for item in chats[-10:]]
    except BaseException:
        return []


def build_live_dashboard_embed():
    brand = _ui("brand", "")
    title = _ui("dashboard.title", "{brand}").format(
        brand=brand
    )

    roster = _roster_items()
    player_count = len(roster)

    current = ""
    next_map = ""

    try:
        current = str(stats.get("playlist", {}).get("current", ""))
        next_map = str(stats.get("playlist", {}).get("next", ""))
    except BaseException:
        pass

    mode, current_map = _split_game_label(current)

    if not next_map:
        next_map = _ui("dashboard.no_next_map", "")

    connected = player_count > 0

    embed = discord.Embed(
        title=title,
        description=_ui("dashboard.description", ""),
        colour=discord.Colour(
            _ui_color(
                "colors.online" if connected
                else "colors.offline"
            )
        ),
        timestamp=discord.utils.utcnow(),
    )

    embed.add_field(
        name=f"{_ui('emojis.online', '🟢')} {_ui('dashboard.field_status', 'STATUS')}",
        value=_ui("dashboard.online", "ONLINE")
        if connected
        else _ui("dashboard.offline", "OFFLINE"),
        inline=True,
    )

    embed.add_field(
        name=f"{_ui('emojis.players', '👥')} {_ui('dashboard.field_players', 'PLAYERS')}",
        value=f"`{player_count} / {max_players}`",
        inline=True,
    )

    embed.add_field(
        name=f"{_ui('emojis.match', '⚔️')} {_ui('dashboard.field_match', 'MATCH')}",
        value=f"`{_safe_text(mode or _ui('dashboard.no_current_map', ''))}`",
        inline=True,
    )

    embed.add_field(
        name=f"{_ui('emojis.map', '🗺️')} {_ui('dashboard.field_current_map', 'CURRENT MAP')}",
        value=f"`{_safe_text(current_map)}`",
        inline=True,
    )

    embed.add_field(
        name=f"{_ui('emojis.next', '⏭️')} {_ui('dashboard.field_next_map', 'NEXT MAP')}",
        value=f"`{_safe_text(next_map)}`",
        inline=True,
    )

    player_lines = []

    for item in roster:
        player_lines.append(
            _ui("player_line", "• {name}").format(
                name=_safe_text(item["name"])
            )
        )

    if not player_lines:
        player_value = _ui(
            "dashboard.empty_players",
            "No players connected.",
        )
    else:
        player_value = "\n".join(player_lines)

    embed.add_field(
        name=f"{_ui('emojis.players', '👥')} {_ui('dashboard.field_roster', 'PLAYERS ONLINE')}",
        value=player_value[:1024],
        inline=False,
    )

    join_address = _join_address()

    if join_address:
        connection_value = (
            "```text\n"
            + join_address
            + "\n```"
            + "\n"
            + _ui("dashboard.connection_hint", "")
        )
    else:
        connection_value = _ui(
            "dashboard.connection_hint",
            "",
        )

    embed.add_field(
        name=f"{_ui('emojis.join', '🔗')} {_ui('dashboard.field_connection', 'QUICK JOIN')}",
        value=connection_value[:1024],
        inline=False,
    )

    recent = _recent_chats()

    if not recent:
        chat_preview = _ui(
            "dashboard.no_chat",
            "No recent in-game chat.",
        )
    else:
        chat_preview = "\n".join(
            f"`{_safe_text(line)}`"
            for line in recent[-4:]
        )

    embed.add_field(
        name=f"{_ui('emojis.chat', '💬')} {_ui('dashboard.field_chat', 'LIVE CHAT')}",
        value=chat_preview[:1024],
        inline=False,
    )

    embed.set_footer(
        text=_ui("dashboard.footer", "").format(
            interval=int(refresh_interval)
        )
    )

    return embed


def build_live_chat_embed():
    brand = _ui("brand", "")
    recent = _recent_chats()

    embed = discord.Embed(
        title=(
            f"{_ui('emojis.chat', '💬')} "
            f"{_ui('dialogs.chat_title', 'LIVE CHAT')}"
        ),
        colour=discord.Colour(
            _ui_color("colors.info")
        ),
        timestamp=discord.utils.utcnow(),
    )

    if not liveChat:
        embed.description = _ui(
            "dashboard.chat_disabled",
            "",
        )
    elif not recent:
        embed.description = _ui(
            "dashboard.no_chat",
            "",
        )
    else:
        lines = []

        for line in recent:
            lines.append(
                f"> {_safe_text(line)}"
            )

        embed.description = "\n".join(lines)[0:4000]

    embed.set_footer(
        text=brand
    )

    return embed


async def update_live_dashboard_message(force=False):
    global _last_dashboard_embed
    global _last_chat_embed

    if len(livestatsmsgs) < 2:
        return

    dashboard = build_live_dashboard_embed()
    chat_embed = build_live_chat_embed()

    dashboard_dict = dashboard.to_dict()
    chat_dict = chat_embed.to_dict()

    if force or dashboard_dict != _last_dashboard_embed:
        await livestatsmsgs[0].edit(
            content=None,
            embed=dashboard,
            view=LiveDashboardView(),
        )
        _last_dashboard_embed = dashboard_dict

    if force or chat_dict != _last_chat_embed:
        await livestatsmsgs[1].edit(
            content=None,
            embed=chat_embed,
            view=None,
        )
        _last_chat_embed = chat_dict


class LiveDashboardView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=None)

        self.add_item(
            discord.ui.Button(
                label=_ui("buttons.refresh", "Refresh"),
                style=discord.ButtonStyle.secondary,
                custom_id="cypher_live_refresh",
                emoji=None,
            )
        )

        self.add_item(
            discord.ui.Button(
                label=_ui("buttons.players", "Players"),
                style=discord.ButtonStyle.primary,
                custom_id="cypher_live_players",
                emoji=None,
            )
        )

        self.add_item(
            discord.ui.Button(
                label=_ui("buttons.join", "Join Info"),
                style=discord.ButtonStyle.success,
                custom_id="cypher_live_join",
                emoji=None,
            )
        )

        self.add_item(
            discord.ui.Button(
                label=_ui("buttons.chat", "Live Chat"),
                style=discord.ButtonStyle.secondary,
                custom_id="cypher_live_chat",
                emoji=None,
            )
        )

        for item in self.children:
            item.callback = self._callback

    async def _callback(self, interaction):
        custom_id = getattr(interaction.data, "get", lambda *_: None)(
            "custom_id"
        )

        if custom_id == "cypher_live_refresh":
            await update_live_dashboard_message(force=True)
            await interaction.response.send_message(
                _ui("dialogs.refresh", ""),
                ephemeral=True,
            )
            return

        if custom_id == "cypher_live_players":
            lines = []

            for index, item in enumerate(_roster_items(), start=1):
                lines.append(
                    f"{index}. {item['name']}"
                )

            if not lines:
                message = _ui(
                    "dialogs.players_empty",
                    "```text\nNo players connected.\n```",
                )
            else:
                message = (
                    "```text\n"
                    + "\n".join(lines)
                    + "\n```"
                )

            await interaction.response.send_message(
                message,
                ephemeral=True,
            )
            return

        if custom_id == "cypher_live_join":
            address = _join_address()

            await interaction.response.send_message(
                f"{_ui('dialogs.join_title', 'QUICK JOIN')}\n"
                f"```text\n{address}\n```",
                ephemeral=True,
            )
            return

        if custom_id == "cypher_live_chat":
            recent = _recent_chats()

            if recent:
                message = (
                    f"{_ui('dialogs.chat_title', 'LIVE CHAT')}\n"
                    "```text\n"
                    + "\n".join(recent)
                    + "\n```"
                )
            else:
                message = _ui(
                    "dialogs.chat_empty",
                    "```text\nNo recent chat.\n```",
                )

            await interaction.response.send_message(
                message[:1900],
                ephemeral=True,
            )
            return

        await interaction.response.send_message(
            _ui("dialogs.status_title", ""),
            ephemeral=True,
        )


async def verify_channel():
    global livestatsmsgs
    global live_stats_message_id
    global live_chat_message_id
    global _refresh_task
    global _logs_task
    global _last_dashboard_embed
    global _last_chat_embed

    channel = client.get_channel(liveStatsChannelID)

    if channel is None:
        try:
            channel = await client.fetch_channel(liveStatsChannelID)
        except BaseException:
            logging.exception(
                "Unable to access the configured live-stats channel."
            )
            return

    state = {}

    try:
        state_path = os.path.expanduser(state_file)

        if os.path.isfile(state_path):
            with open(
                state_path,
                "r",
                encoding="utf-8",
            ) as state_handle:
                state = json.load(state_handle)

    except (OSError, ValueError):
        state = {}

    stats_id = state.get("live_stats_message_id")
    chat_id = state.get("live_chat_message_id")

    stats_message = None
    chat_message = None

    if stats_id:
        try:
            stats_message = await channel.fetch_message(
                int(stats_id)
            )

            if stats_message.author.id != client.user.id:
                stats_message = None

        except (
            discord.NotFound,
            discord.HTTPException,
            ValueError,
        ):
            stats_message = None

    if chat_id:
        try:
            chat_message = await channel.fetch_message(
                int(chat_id)
            )

            if chat_message.author.id != client.user.id:
                chat_message = None

        except (
            discord.NotFound,
            discord.HTTPException,
            ValueError,
        ):
            chat_message = None

    if stats_message is None:
        stats_message = await channel.send(
            embed=build_live_dashboard_embed(),
            view=LiveDashboardView(),
        )

    if chat_message is None:
        chat_message = await channel.send(
            embed=build_live_chat_embed(),
        )

    live_stats_message_id = int(stats_message.id)
    live_chat_message_id = int(chat_message.id)

    livestatsmsgs = [
        stats_message,
        chat_message,
    ]

    try:
        state_path = os.path.expanduser(state_file)

        os.makedirs(
            os.path.dirname(state_path),
            exist_ok=True,
        )

        state = {
            "live_stats_message_id": live_stats_message_id,
            "live_chat_message_id": live_chat_message_id,
        }

        with open(
            state_path,
            "w",
            encoding="utf-8",
        ) as state_handle:
            json.dump(
                state,
                state_handle,
                indent=2,
            )
            state_handle.write("\n")

        try:
            os.chmod(state_path, 0o600)
        except OSError:
            pass

    except OSError:
        logging.exception(
            "Unable to persist Discord live-message state."
        )

    _last_dashboard_embed = None
    _last_chat_embed = None

    await update_live_dashboard_message(force=True)

    if _refresh_task is None or _refresh_task.done():
        _refresh_task = asyncio.create_task(
            refresh_stats()
        )

    if _logs_task is None or _logs_task.done():
        _logs_task = asyncio.create_task(
            send_logs()
        )



    # client.loop.create_task(refresh_stats())
    # client.loop.create_task(send_logs())


async def refresh_stats():
    await client.wait_until_ready()

    while not client.is_closed():
        if len(livestatsmsgs) >= 2:
            try:
                await update_live_dashboard_message(
                    force=False
                )
            except BaseException:
                logging.exception(
                    "Unable to update Discord dashboard."
                )

        await asyncio.sleep(
            max(float(refresh_interval), 1.0)
        )





async def send_logs():
    global logs

    await client.wait_until_ready()

    channel = client.get_channel(logsChannelID)

    if channel is None:
        try:
            channel = await client.fetch_channel(logsChannelID)
        except BaseException:
            logging.exception("Unable to access the configured logs channel.")
            return

    while not client.is_closed():
        if logs:
            pending = logs
            logs = []

            msg = "\n".join(str(item) for item in pending)

            # Discord's normal message limit is larger than this batch size;
            # keeping chunks below it avoids one oversized log message.
            chunk_size = 1900

            for start in range(0, len(msg), chunk_size):
                chunk = msg[start:start + chunk_size]
                if chunk:
                    try:
                        await channel.send(chunk)
                    except BaseException:
                        logging.exception("Unable to send Discord logs.")
                        break

        await asyncio.sleep(max(float(refresh_interval), 1.0))



def get_live_players_msg():
    return build_live_dashboard_embed().description or ""




def get_chats():
    return build_live_chat_embed().description or ""




class BsDataThread(object):
    def __init__(self):
        # Do not query ClassicAppMode immediately during custom_hooks
        # bootstrap; the app mode may not be active yet.
        # The repeating Ballistica timer performs the first refresh shortly
        # after startup when the game state is available.
        self.Timer = bs.AppTimer(
            stats_refresh_interval,
            babase.Call(self.refreshStats),
            repeat=True,
        )
        # self.Timerr = bs.Timer( 10,babase.Call(self.refreshLeaderboard),timetype = babase.TimeType.REAL,repeat = True)

    # def refreshLeaderboard(self):
    #     global leaderboard
    #     global top200
    #     _t200={}
    #     f=open(statsfile)
    #     lboard=json.loads(f.read())
    #     leaderboard=lboard
    #     entries = [(a['scores'], a['kills'], a['deaths'], a['games'], a['name_html'], a['aid'],a['last_seen']) for a in lboard.values()]

    #     entries.sort(reverse=True)
    #     rank=0
    #     for entry in entries:
    #         rank+=1
    #         if rank >201:
    #             break
    #         _t200[entry[5]]={"rank":rank,"scores":int(entry[0]),"games":int(entry[3]),"kills":int(entry[1]),"deaths":int(entry[2]),"name_html":entry[4],"last_seen":entry[6]}
    #         top200=_t200

    def refreshStats(self):

        liveplayers = {}
        nextMap = ''
        currentMap = ''
        global stats

        for i in bs.get_game_roster():
            try:
                liveplayers[i['account_id']] = {
                    'name': i['players'][0]['name_full'],
                    'client_id': i['client_id'],
                    'device_id': i['display_string']}
            except:
                liveplayers[i['account_id']] = {
                    'name': "<in-lobby>", 'clientid': i['client_id'],
                    'device_id': i['display_string']}
        try:
            nextMap = bs.get_foreground_host_session(
            ).get_next_game_description().evaluate()

            current_game_spec = bs.get_foreground_host_session()._current_game_spec
            gametype = current_game_spec['resolved_type']

            currentMap = gametype.get_settings_display_string(
                current_game_spec).evaluate()
        except:
            pass
        minigame = {'current': currentMap, 'next': nextMap}
        # system={'cpu':p.cpu_percent(),'ram':p.virtual_memory().percent}
        # system={'cpu':80,'ram':34}
        # stats['system']=system
        stats['roster'] = liveplayers
        try:
            stats['chats'] = bs.get_chat_messages()
        except RuntimeError:
            # ClassicAppMode can briefly be inactive during startup/map
            # transitions. Keep the Discord stats system alive in that case.
            stats['chats'] = []
        stats['playlist'] = minigame

        # stats['teamInfo']=self.getTeamInfo()
