# Runtime configuration injected by custom_hooks.py from setting.json.
logsChannelID = 0
liveStatsChannelID = 0
notifyChannelID = 0
complaintChannelID = 0
guildID = 0

liveChat = True
bot_prefix = ""
token = ""

refresh_interval = 10.0
stats_refresh_interval = 8.0
channel_history_limit = 20
