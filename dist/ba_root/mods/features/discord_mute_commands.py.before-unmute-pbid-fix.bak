from __future__ import annotations

import json
from pathlib import Path
from typing import Any

from discord.ext import commands

from features import mute_system


ROOT_MODS = Path(__file__).resolve().parents[1]
SETTING_PATH = ROOT_MODS / "setting.json"


def _load_config() -> dict[str, Any]:
    try:
        root = json.loads(
            SETTING_PATH.read_text(
                encoding="utf-8"
            )
        )
    except Exception:
        root = {}

    return (
        root
        .get("discordbot", {})
        .get("commandConfig", {})
        .get("muteSystem", {})
    )


CFG = _load_config()
MESSAGES = CFG.get(
    "messages",
    {},
)

MIN_DURATION = int(
    CFG.get(
        "min_duration_days",
        1,
    )
)

MAX_LIST = int(
    CFG.get(
        "max_list_entries",
        10,
    )
)

MAX_DETAILS = int(
    CFG.get(
        "max_details_accounts",
        25,
    )
)


def _message(
    key: str,
    **values: Any,
) -> str:
    # Keep message templates compatible with both naming conventions.
    values = dict(values)

    if "pbid" not in values and "target" in values:
        values["pbid"] = values["target"]

    if "target" not in values and "pbid" in values:
        values["target"] = values["pbid"]

    return str(
        MESSAGES[key]
    ).format(**values)


def _staff(
    ctx: commands.Context,
) -> bool:
    permissions = getattr(
        ctx.author,
        "guild_permissions",
        None,
    )

    if permissions is None:
        return False

    required = CFG.get(
        "required_discord_permissions",
        ["administrator"],
    )

    for permission in required:
        if bool(
            getattr(
                permissions,
                permission,
                False,
            )
        ):
            return True

    return False


def _valid_pbid(
    value: str,
) -> bool:
    return (
        isinstance(value, str)
        and value.startswith("pb-")
        and len(value) >= 4
    )


def _clean_reason(
    value: str | None,
) -> str:
    return str(
        value or ""
    ).strip()


async def mute_command(
    ctx: commands.Context,
    pbid: str | None = None,
    days: str | None = None,
    *,
    reason: str | None = None,
) -> None:

    if not _staff(ctx):
        await ctx.send(
            _message(
                "no_permission"
            )
        )
        return

    if not pbid or not _valid_pbid(pbid):
        await ctx.send(
            _message(
                "invalid_pbid"
            )
        )
        return

    try:
        duration = int(
            days or ""
        )
    except ValueError:
        await ctx.send(
            _message(
                "invalid_duration"
            )
        )
        return

    if duration < MIN_DURATION:
        await ctx.send(
            _message(
                "invalid_duration"
            )
        )
        return

    reason_text = _clean_reason(
        reason
    )

    if not reason_text:
        await ctx.send(
            _message(
                "missing_reason"
            )
        )
        return

    try:
        record = mute_system.create_mute(
            pbid=pbid,
            days=duration,
            reason=reason_text,
            created_by={
                "id": str(
                    ctx.author.id
                ),
                "name": str(
                    ctx.author
                ),
            },
        )

    except mute_system.AlreadyMuted:
        await ctx.send(
            _message(
                "already_muted"
            )
        )
        return

    linked = record.get(
        "linked_accounts",
        [],
    )

    await ctx.send(
        _message(
            "mute_success",
            target=pbid,
            count=len(linked),
            expires=mute_system.format_time(
                record.get(
                    "expires_at"
                )
            ),
            reason=reason_text.replace(
                "`",
                "",
            ),
        )
    )


async def unmute_command(
    ctx: commands.Context,
    pbid: str | None = None,
) -> None:

    if not _staff(ctx):
        await ctx.send(
            _message(
                "no_permission"
            )
        )
        return

    if not pbid or not _valid_pbid(pbid):
        await ctx.send(
            _message(
                "invalid_pbid"
            )
        )
        return

    result = mute_system.unmute_pbid(
        pbid
    )

    if not result["removed"] and not result["accounts"]:
        await ctx.send(
            _message(
                "not_muted"
            )
        )
        return

    await ctx.send(
        _message(
            "unmute_success",
            pbid=pbid,
            count=len(
                result["accounts"]
            ),
        )
    )


async def mutecheck_command(
    ctx: commands.Context,
    pbid: str | None = None,
) -> None:

    if not _staff(ctx):
        await ctx.send(
            _message(
                "no_permission"
            )
        )
        return

    if not pbid or not _valid_pbid(pbid):
        await ctx.send(
            _message(
                "invalid_pbid"
            )
        )
        return

    records = mute_system.matching_records(
        pbid=pbid
    )

    if not records:
        legacy = mute_system.legacy_mute_info(
            pbid
        )

        if legacy is None:
            await ctx.send(
                _message(
                    "mutecheck_clear",
                    pbid=pbid,
                )
            )
            return

        await ctx.send(
            _message(
                "mutecheck_legacy",
                pbid=pbid,
                expires=mute_system.format_time(
                    legacy.get(
                        "expires_at"
                    )
                ),
                reason=str(
                    legacy.get(
                        "reason",
                        "Legacy mute",
                    )
                ).replace(
                    "`",
                    "",
                ),
            )
        )
        return

    lines = []

    for record in records[:MAX_LIST]:
        lines.append(
            _message(
                "mutecheck_entry",
                reason=str(
                    record.get(
                        "reason",
                        "Unknown",
                    )
                ).replace(
                    "`",
                    "",
                ),
                expires=mute_system.format_time(
                    record.get(
                        "expires_at"
                    )
                ),
            )
        )

    await ctx.send(
        (
            _message(
                "mutecheck_banned",
                pbid=pbid,
                count=len(records),
            )
            + "\n"
            + "\n".join(lines)
        ).replace(
            "\\n",
            "\n",
        )
    )


async def mutelist_command(
    ctx: commands.Context,
) -> None:

    if not _staff(ctx):
        await ctx.send(
            _message(
                "no_permission"
            )
        )
        return

    records = mute_system.active_records()

    if not records:
        await ctx.send(
            _message(
                "mutelist_empty"
            )
        )
        return

    lines = []

    for record in records[:MAX_LIST]:
        identities = record.get(
            "identities",
            {},
        )

        if not isinstance(
            identities,
            dict,
        ):
            identities = {}

        lines.append(
            _message(
                "mutelist_entry",
                name=str(
                    record.get(
                        "source_name",
                        "Unknown",
                    )
                ).replace(
                    "`",
                    "",
                ),
                pbid=str(
                    record.get(
                        "source",
                        "unknown",
                    )
                ),
                reason=str(
                    record.get(
                        "reason",
                        "Unknown",
                    )
                ).replace(
                    "`",
                    "",
                ),
                created=mute_system.format_time(
                    record.get(
                        "created_at"
                    )
                ),
                expires=mute_system.format_time(
                    record.get(
                        "expires_at"
                    )
                ),
                accounts=len(
                    identities.get(
                        "accounts",
                        [],
                    )
                ),
                ips=len(
                    identities.get(
                        "ips",
                        [],
                    )
                ),
                devices=len(
                    identities.get(
                        "devices",
                        [],
                    )
                ),
            )
        )

    await ctx.send(
        (
            _message(
                "mutelist_header",
                count=len(records),
            )
            + "\n"
            + "\n".join(lines)
        ).replace(
            "\\n",
            "\n",
        )
    )


async def mutedetails_command(
    ctx: commands.Context,
    pbid: str | None = None,
) -> None:

    if not _staff(ctx):
        await ctx.send(
            _message(
                "no_permission"
            )
        )
        return

    if not pbid or not _valid_pbid(pbid):
        await ctx.send(
            _message(
                "invalid_pbid"
            )
        )
        return

    records = mute_system.matching_records(
        pbid=pbid
    )

    if not records:
        await ctx.send(
            _message(
                "not_muted"
            )
        )
        return

    lines = []

    for record in records[:MAX_LIST]:
        identities = record.get(
            "identities",
            {},
        )

        if not isinstance(
            identities,
            dict,
        ):
            identities = {}

        lines.append(
            _message(
                "mutedetails_header",
                pbid=pbid,
                name=str(
                    record.get(
                        "source_name",
                        "Unknown",
                    )
                ).replace(
                    "`",
                    "",
                ),
                reason=str(
                    record.get(
                        "reason",
                        "Unknown",
                    )
                ).replace(
                    "`",
                    "",
                ),
                created=mute_system.format_time(
                    record.get(
                        "created_at"
                    )
                ),
                expires=mute_system.format_time(
                    record.get(
                        "expires_at"
                    )
                ),
                accounts=len(
                    identities.get(
                        "accounts",
                        [],
                    )
                ),
                ips=len(
                    identities.get(
                        "ips",
                        []
                    )
                ),
                devices=len(
                    identities.get(
                        "devices",
                        []
                    )
                ),
            )
        )

        account_lines = []

        for entry in record.get(
            "linked_accounts",
            [],
        )[:MAX_DETAILS]:

            if not isinstance(
                entry,
                dict,
            ):
                continue

            account_lines.append(
                _message(
                    "mutedetails_account",
                    pbid=entry.get(
                        "pbid",
                        "unknown",
                    ),
                    name=str(
                        entry.get(
                            "name",
                            "Unknown",
                        )
                    ).replace(
                        "`",
                        "",
                    ),
                    matched_by=", ".join(
                        entry.get(
                            "matched_by",
                            [],
                        )
                    ) or "account",
                )
            )

        if account_lines:
            lines.append(
                "\n".join(
                    account_lines
                )
            )

    await ctx.send(
        "\n".join(
            lines
        ).replace(
            "\\n",
            "\n",
        )
    )
